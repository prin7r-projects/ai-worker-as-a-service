# Shiftledger — environment variables (list names only; never commit live values)

# --- Landing (Wave 2, already on storage-contabo) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
NEXT_PUBLIC_APP_URL=https://ai-worker-as-a-service.prin7r.com

# --- App (Wave 3) ---
DATABASE_URL=postgres://shiftledger:shiftledger@localhost:5432/shiftledger
INTEGRATION_KEY=           # AES-256-GCM key for encrypting integration tokens (64 hex chars)
ADMIN_API_KEY=              # Bearer token for /api/admin/* endpoints (64+ hex chars)
NOTION_TOKEN=               # Notion integration token for contract sync
NOTION_CONTRACTS_DSID=35a3ceec-2619-81eb-bfaf-e9d0060d36f1      # Notion data source ID for Shiftledger Contracts
POSTMARK_API_KEY=           # Transactional email via Postmark
POSTMARK_FROM_EMAIL=desk@ai-worker-as-a-service.prin7r.com
POSTMARK_TEMPLATE_ALIAS=    # Optional: Postmark template alias for onboarding emails

# --- Internal services (Phase 3+) ---
APP_SERVER_URL=http://localhost:3001      # Used by landing webhook to call app internal APIs
DASHBOARD_URL=http://localhost:3001/app    # Customer dashboard URL for onboarding emails

# --- Integrations (Phase 2+) ---
ZENDESK_SUBDOMAIN=          # e.g. 'mycompany' → mycompany.zendesk.com
SALESFORCE_INSTANCE_URL=    # e.g. 'https://mycompany.my.salesforce.com'

# --- Redis (for BullMQ queues, Phase 1+) ---
REDIS_URL=redis://localhost:6379

# --- Slack alerts (Phase 4) ---
SLACK_WEBHOOK_URL=
