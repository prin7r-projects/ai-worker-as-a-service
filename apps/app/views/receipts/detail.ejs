<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt — Shiftledger</title>
  <style>
    /* Shiftledger receipt page — tokens lifted from DESIGN.md section 4.
       No purple/violet gradients, no yellow/amber, no beige. Black + paper
       + audit blue + payday green + flag red only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'SF Mono', 'Cascadia Code', 'Consolas', monospace;
      color: #0E0E0C;            /* ink */
      background: #FAFAF8;        /* paper */
      line-height: 1.6;
    }
    .receipt-container {
      max-width: 800px;
      margin: 40px auto;
      background: #FFFFFF;        /* card-white */
      border: 1px solid #E5E5E5;  /* chalk */
      border-radius: 0;
      box-shadow: 0 1px 0 0 rgba(14,14,12,.10); /* hairline ledger */
      overflow: hidden;
    }
    .receipt-header {
      padding: 32px 40px;
      border-bottom: 1px solid #0E0E0C; /* ink hairline */
      background: #0E0E0C;         /* ink — obsidian band, replaces the old purple gradient */
      color: #FAFAF8;             /* paper */
    }
    .receipt-header.partner-branded {
      background: #3A3A36;         /* ink-2 — same neutral family, no secondary hue */
    }
    .receipt-logo-row {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }
    .receipt-logo-row img {
      max-height: 48px;
      max-width: 200px;
      object-fit: contain;
    }
    .receipt-org-name {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.5px;
    }
    .receipt-title {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 2px;
      opacity: 0.85;
    }
    .receipt-body {
      padding: 32px 40px;
    }
    .receipt-section {
      margin-bottom: 28px;
    }
    .receipt-section-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #777169;             /* gravel */
      margin-bottom: 12px;
      border-bottom: 1px solid #E5E5E5; /* chalk */
      padding-bottom: 6px;
    }
    .ledger-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      font-size: 14px;
      border-bottom: 1px dotted #E5E5E5; /* chalk */
    }
    .ledger-row .label {
      color: #777169;             /* gravel */
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .ledger-row .value {
      font-family: 'SF Mono', monospace;
      font-weight: 500;
      text-align: right;
    }
    .status-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 0;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      border: 1px solid;
    }
    /* Status badges mapped onto the locked palette only.
       Escalated (formerly purple) is flagged red — voids need attention. */
    .status-cleared    { background: #FFFFFF; color: #2E6F40; border-color: #2E6F40; } /* payday */
    .status-voided     { background: #FFFFFF; color: #B5371F; border-color: #B5371F; } /* flag */
    .status-disputed   { background: #FFFFFF; color: #1F4F8A; border-color: #1F4F8A; } /* audit */
    .status-escalated  { background: #FFFFFF; color: #B5371F; border-color: #B5371F; } /* flag — escalated = void in progress */
    .amount-line {
      font-size: 18px;
      font-weight: 700;
      font-family: 'SF Mono', monospace;
      color: #2E6F40;             /* payday — charged amount, audit-grade */
    }
    .receipt-footer {
      padding: 20px 40px;
      border-top: 1px solid #0E0E0C; /* ink hairline */
      background: #F5F3F1;        /* paper-2 — powder surface */
      font-size: 12px;
      color: #777169;             /* gravel */
      text-align: center;
    }
    .partner-footer {
      font-size: 13px;
      color: #3A3A36;             /* ink-2 */
    }
    .partner-footer a {
      color: #1F4F8A;             /* audit */
      text-decoration: none;
    }
    .print-btn {
      display: block;
      margin: 24px auto;
      padding: 10px 28px;
      background: #0E0E0C;         /* ink — primary CTA, was indigo */
      color: #FAFAF8;             /* paper */
      border: 1px solid #0E0E0C;
      border-radius: 9999px;      /* pill per DESIGN.md */
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.12s ease-out;
    }
    .print-btn:hover { background: #1F4F8A; } /* audit hover state */
    @media print {
      body { background: white; }
      .receipt-container { box-shadow: none; border: none; margin: 0; max-width: 100%; }
      .print-btn { display: none; }
    }
  </style>
</head>
<body>
  <div class="receipt-container">
    <!-- Receipt Header — white-label when partner branding exists -->
    <div class="receipt-header<%= partnerBranding ? ' partner-branded' : '' %>">
      <div class="receipt-logo-row">
        <% if (partnerBranding && partnerBranding.logoDataUrl) { %>
          <img src="<%= partnerBranding.logoDataUrl %>" alt="Partner logo" />
        <% } %>
        <div>
          <div class="receipt-title">Shiftledger Receipt</div>
          <div class="receipt-org-name">
            <%= (customer && customer.orgName) ? customer.orgName : (partnerBranding ? partnerBranding.referralCode : 'Shiftledger') %>
          </div>
        </div>
      </div>
    </div>

    <!-- Receipt Body -->
    <div class="receipt-body">
      <!-- Line Item -->
      <div class="receipt-section">
        <div class="receipt-section-title">Line Item</div>
        <div class="ledger-row">
          <span class="label">Receipt ID</span>
          <span class="value"><%= line.id %></span>
        </div>
        <div class="ledger-row">
          <span class="label">External ID</span>
          <span class="value"><%= line.externalId || '—' %></span>
        </div>
        <div class="ledger-row">
          <span class="label">Status</span>
          <span class="value">
            <span class="status-badge status-<%= line.status %>"><%= line.status.toUpperCase() %></span>
          </span>
        </div>
        <div class="ledger-row">
          <span class="label">Unit Price</span>
          <span class="value amount-line"><%= typeof formatCurrency === 'function' ? formatCurrency(line.unitPriceUsd) : '$' + (parseFloat(line.unitPriceUsd || '0')).toFixed(2) %></span>
        </div>
      </div>

      <!-- Shift Info -->
      <% if (shift) { %>
      <div class="receipt-section">
        <div class="receipt-section-title">Shift</div>
        <div class="ledger-row">
          <span class="label">Shift ID</span>
          <span class="value"><%= shift.id %></span>
        </div>
        <div class="ledger-row">
          <span class="label">Shift Status</span>
          <span class="value"><%= shift.status %></span>
        </div>
        <% if (shift.startedAt) { %>
        <div class="ledger-row">
          <span class="label">Started</span>
          <span class="value"><%= typeof formatDate === 'function' ? formatDate(shift.startedAt) : shift.startedAt %></span>
        </div>
        <% } %>
        <% if (shift.endedAt) { %>
        <div class="ledger-row">
          <span class="label">Ended</span>
          <span class="value"><%= typeof formatDate === 'function' ? formatDate(shift.endedAt) : shift.endedAt %></span>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- Contract Info -->
      <% if (contract) { %>
      <div class="receipt-section">
        <div class="receipt-section-title">Contract</div>
        <div class="ledger-row">
          <span class="label">Contract ID</span>
          <span class="value"><%= contract.id %></span>
        </div>
        <div class="ledger-row">
          <span class="label">Tier</span>
          <span class="value"><%= contract.tier %></span>
        </div>
        <% if (workerProfile) { %>
        <div class="ledger-row">
          <span class="label">Worker Profile</span>
          <span class="value"><%= workerProfile.displayName %></span>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- Verification Details -->
      <% if (line.verificationDetails) { %>
      <div class="receipt-section">
        <div class="receipt-section-title">Verification Details</div>
        <pre style="font-size:12px; color:#777169; overflow-x:auto; white-space:pre-wrap;"><%= JSON.stringify(line.verificationDetails, null, 2) %></pre>
      </div>
      <% } %>
    </div>

    <!-- Receipt Footer — white-label when partner branding exists -->
    <div class="receipt-footer">
      <% if (partnerBranding) { %>
        <div class="partner-footer">
          <% if (partnerBranding.footerText) { %>
            <strong><%= partnerBranding.footerText %></strong><br>
          <% } %>
          <% if (partnerBranding.contactEmail) { %>
            <a href="mailto:<%= partnerBranding.contactEmail %>"><%= partnerBranding.contactEmail %></a>
          <% } %>
        </div>
      <% } else { %>
        <div>Shiftledger — AI Worker Fleet Platform</div>
        <div>Receipt generated <%= new Date().toISOString().slice(0, 10) %></div>
      <% } %>
    </div>
  </div>

  <button class="print-btn" onclick="window.print()">🖨️ Print / Save as PDF</button>
</body>
</html>
