<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Changelog — Shiftledger</title>
  <style>
    /* Shiftledger changelog — DESIGN.md section 4 tokens only.
       No purple gradients, no amber drift badges, no off-palette slate. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #0E0E0C;            /* ink */
      background: #FAFAF8;        /* paper */
      line-height: 1.6;
    }
    .changelog-container {
      max-width: 720px;
      margin: 40px auto;
      padding: 0 20px;
    }
    .changelog-header {
      text-align: center;
      margin-bottom: 40px;
    }
    .changelog-header h1 {
      font-size: 32px;
      font-weight: 800;
      color: #0E0E0C;             /* ink — was purple gradient text-fill */
    }
    .changelog-header p {
      color: #777169;             /* gravel */
      margin-top: 8px;
    }
    .changelog-date-group {
      margin-bottom: 32px;
    }
    .changelog-date-label {
      font-size: 14px;
      font-weight: 700;
      color: #777169;             /* gravel */
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid #E5E5E5; /* chalk */
    }
    .changelog-entry {
      display: flex;
      gap: 16px;
      padding: 16px 20px;
      background: #FFFFFF;        /* card-white */
      border: 1px solid #E5E5E5;  /* chalk */
      border-radius: 0;
      margin-bottom: 10px;
      transition: border-color 0.12s ease-out;
    }
    .changelog-entry:hover {
      border-color: #1F4F8A;     /* audit hover per DESIGN.md section 11 */
    }
    .changelog-entry-icon {
      font-size: 24px;
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #F5F3F1;        /* paper-2 */
      border: 1px solid #E5E5E5;
      border-radius: 0;
    }
    .changelog-entry-body {
      flex: 1;
    }
    .changelog-entry-title {
      font-size: 16px;
      font-weight: 600;
      color: #0E0E0C;             /* ink */
    }
    .changelog-entry-desc {
      font-size: 14px;
      color: #3A3A36;             /* ink-2 */
      margin-top: 4px;
      line-height: 1.5;
    }
    .changelog-entry-time {
      font-size: 11px;
      color: #A59F97;             /* slate */
      margin-top: 6px;
      font-family: 'SF Mono', monospace;
    }
    .changelog-empty {
      text-align: center;
      padding: 60px 20px;
      color: #A59F97;             /* slate */
    }
    .changelog-empty-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }
    .changelog-footer {
      text-align: center;
      padding: 40px 0;
      color: #A59F97;             /* slate */
      font-size: 13px;
    }
    .changelog-footer a {
      color: #1F4F8A;             /* audit */
      text-decoration: none;
    }
    .changelog-footer a:hover {
      text-decoration: underline;
    }
    .badge-event {
      display: inline-block;
      padding: 1px 8px;
      border-radius: 0;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-left: 8px;
      vertical-align: middle;
      border: 1px solid;
    }
    /* Event badges — palette-aligned, no off-palette green/amber/blue/slate. */
    .badge-profile_added { background: #FFFFFF; color: #2E6F40; border-color: #2E6F40; } /* payday */
    .badge-drift_event   { background: #FFFFFF; color: #1F4F8A; border-color: #1F4F8A; } /* audit (was amber/yellow) */
    .badge-payout        { background: #FFFFFF; color: #2E6F40; border-color: #2E6F40; } /* payday */
    .badge-system        { background: #F5F3F1; color: #3A3A36; border-color: #E5E5E5; } /* paper-2 + ink-2 + chalk */
  </style>
</head>
<body>
  <div class="changelog-container">
    <div class="changelog-header">
      <h1>Shiftledger Changelog</h1>
      <p>What's new — last 30 days of profile additions, drift events, and partner payouts.</p>
    </div>

    <% if (entries.length === 0) { %>
      <div class="changelog-empty">
        <div class="changelog-empty-icon">📋</div>
        <p>No changelog entries yet.</p>
        <p style="margin-top:8px">Events will appear here as profiles are added, drift statuses change, and partner payouts are processed.</p>
      </div>
    <% } %>

    <% const dateKeys = Object.keys(grouped).sort().reverse(); %>
    <% for (const dateKey of dateKeys) { %>
      <div class="changelog-date-group">
        <div class="changelog-date-label">
          <%= typeof formatDate === 'function' ? formatDate(dateKey) : dateKey %>
        </div>
        <% for (const entry of (grouped[dateKey] || [])) { %>
          <div class="changelog-entry">
            <div class="changelog-entry-icon">
              <%= typeof formatEventIcon === 'function' ? formatEventIcon(entry.eventType) : '📌' %>
            </div>
            <div class="changelog-entry-body">
              <div class="changelog-entry-title">
                <%= entry.title %>
                <span class="badge-event badge-<%= entry.eventType %>"><%= entry.eventType.replace('_', ' ') %></span>
              </div>
              <% if (entry.description) { %>
                <div class="changelog-entry-desc"><%= entry.description %></div>
              <% } %>
              <div class="changelog-entry-time">
                <%= entry.publishedAt ? new Date(entry.publishedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '' %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="changelog-footer">
      <p>Shiftledger — AI Worker Fleet Platform</p>
      <p><a href="/">Back to home</a></p>
    </div>
  </div>
</body>
</html>
