# =====================================================================
# Tally — apps/landing — public env example
# Variable names match payments-prototypes/.env.example so the pattern
# is consistent across all 20 Wave 2 projects.
# Live values live ONLY in /opt/prin7r-deploys/ai-worker-as-a-service/.env
# on storage-contabo. Never commit real keys here.
# =====================================================================

# Public app URL — used in NOWPayments redirect + IPN callback URLs.
NEXT_PUBLIC_APP_URL=https://ai-worker-as-a-service.prin7r.com
NEXT_PUBLIC_SITE_URL=https://ai-worker-as-a-service.prin7r.com

# NOWPayments — hosted invoice + IPN.
# Production keys are shared across all Wave 2 projects (same merchant).
# Source on the deploy host: /opt/prin7r-deploys/<slug>/.env
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Optional — when fiat invoicing ships in 2026 H2 we'll wire FastSpring here.
# FASTSPRING_API_USERNAME=
# FASTSPRING_API_PASSWORD=
# FASTSPRING_STOREFRONT=

# Optional — Plisio backup rail (documented, not active in Wave 2).
# PLISIO_API_KEY=

# Optional — Reown / WalletConnect (documented, not active in Wave 2).
# NEXT_PUBLIC_REOWN_PROJECT_ID=

# Documentation reference for treasury wallets (not used at runtime).
# CRYPTO_USDT_ADDRESS=
# CRYPTO_USDT_NETWORK=TRC20
# CRYPTO_USDC_ADDRESS=
# CRYPTO_USDC_NETWORK=Base
